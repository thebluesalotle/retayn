# GitHub bot token. Use a fine-grained PAT from a bot/machine account for now,
# or a GitHub App installation token later.
GITHUB_TOKEN=github_token_here
GITHUB_APP_SLUG=retayn-guard-local
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY_PATH=retayn-guard-local.private-key.pem
# Or use GITHUB_PRIVATE_KEY with escaped newlines instead of a file path.

# AI risk review. Keep this secret in .env, never in source.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash

# Public URL for local OAuth callbacks. For ngrok, use the origin only:
# RETAYN_PUBLIC_BASE_URL=https://example.ngrok-free.app
RETAYN_PUBLIC_BASE_URL=http://127.0.0.1:8787

# Retail connector install URLs shown by the dashboard.
# In production these are OAuth/app install URLs owned by Retayn.
SHOPIFY_INSTALL_URL=
SLACK_INSTALL_URL=
GOOGLE_WORKSPACE_INSTALL_URL=
AIRTABLE_INSTALL_URL=
ZENDESK_INSTALL_URL=
META_FACEBOOK_INSTALL_URL=
INSTAGRAM_INSTALL_URL=
LINKEDIN_INSTALL_URL=
GITLAB_INSTALL_URL=
BITBUCKET_INSTALL_URL=
MICROSOFT_365_INSTALL_URL=
TEAMS_INSTALL_URL=
GOOGLE_CLOUD_INSTALL_URL=
AWS_INSTALL_URL=
AZURE_INSTALL_URL=
CLOUDFLARE_INSTALL_URL=
VERCEL_INSTALL_URL=
NETLIFY_INSTALL_URL=
SUPABASE_INSTALL_URL=
FIREBASE_INSTALL_URL=
STRIPE_INSTALL_URL=
PAYPAL_INSTALL_URL=
NOTION_INSTALL_URL=
LINEAR_INSTALL_URL=
ASANA_INSTALL_URL=
JIRA_INSTALL_URL=
WORDPRESS_INSTALL_URL=
WIX_INSTALL_URL=
APPLE_DEVELOPER_INSTALL_URL=
GOOGLE_PLAY_INSTALL_URL=
NPM_INSTALL_URL=
PYPI_INSTALL_URL=
DOCKER_HUB_INSTALL_URL=
GODADDY_INSTALL_URL=
NAMECHEAP_INSTALL_URL=
SQUARESPACE_INSTALL_URL=
WEBFLOW_INSTALL_URL=
CIRCLECI_INSTALL_URL=
BUILDKITE_INSTALL_URL=
HEROKU_INSTALL_URL=
DIGITALOCEAN_INSTALL_URL=
TWILIO_INSTALL_URL=
SENDGRID_INSTALL_URL=
MAILCHIMP_INSTALL_URL=
HUBSPOT_INSTALL_URL=
INTERCOM_INSTALL_URL=
CALENDLY_INSTALL_URL=

# OAuth app credentials used by Retayn to generate install URLs and exchange callback codes.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=
META_FACEBOOK_CLIENT_ID=
META_FACEBOOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Recovery outreach channels. These are Retayn-owned agent credentials, never customer form fields.
# Email lets the recovery agent send from its own support mailbox.
RECOVERY_SMTP_HOST=
RECOVERY_SMTP_PORT=587
RECOVERY_SMTP_USERNAME=
RECOVERY_SMTP_PASSWORD=
RECOVERY_SMTP_FROM_EMAIL=
RECOVERY_SMTP_USE_TLS=true
# Telegram should use MTProto/Telethon from a signed-in Retayn Telegram account.
RECOVERY_TELEGRAM_MTPROTO_API_ID=
RECOVERY_TELEGRAM_MTPROTO_API_HASH=
# Prefer a StringSession in production. For local testing, you can leave this blank and use the session path.
RECOVERY_TELEGRAM_MTPROTO_SESSION=
RECOVERY_TELEGRAM_MTPROTO_SESSION_PATH=recovery_telegram.session
# Optional fallback only. Not needed when MTProto is configured.
RECOVERY_TELEGRAM_BOT_TOKEN=
RECOVERY_TELEGRAM_WEBHOOK_SECRET=
# WhatsApp Cloud API is prepared but first contact still needs an approved template.
RECOVERY_WHATSAPP_ACCESS_TOKEN=
RECOVERY_WHATSAPP_PHONE_NUMBER_ID=
RECOVERY_WHATSAPP_VERIFY_TOKEN=
RECOVERY_WHATSAPP_APP_SECRET=
RECOVERY_WHATSAPP_API_VERSION=v23.0
RECOVERY_WHATSAPP_TEMPLATE_NAME=
RECOVERY_WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Local prototype only: server-side credentials that stand in for completed install/OAuth callbacks.
# Customers should not paste these into the dashboard.
SHOPIFY_ADMIN_TOKEN=
SLACK_BOT_TOKEN=
GOOGLE_WORKSPACE_ADMIN_EMAIL=
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_JSON_PATH=
AIRTABLE_PERSONAL_ACCESS_TOKEN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
# Dashboard sign-in (Google OAuth)
# Create a Web application OAuth client in Google Cloud Console.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
# Optional comma-separated Google email domains. Leave blank to allow any verified Google account.
RETAYN_ALLOWED_GOOGLE_DOMAINS=
# URL-safe base64 for 32 random bytes. Required in production to encrypt provider OAuth tokens at rest.
# Generate once and keep it stable: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
RETAYN_TOKEN_ENCRYPTION_KEY=
# Stable secret for signed remember-me cookies. Generate once and keep it stable.
RETAYN_SESSION_SECRET=
# How long the signed login cookie should remember the user.
RETAYN_SESSION_DAYS=180
